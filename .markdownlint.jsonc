{
  // Lenient config — these docs are prose- and example-heavy.
  "default": true,
  "MD013": false, // line length
  "MD033": false, // inline HTML (SKILL.md uses HTML comments / diagrams)
  "MD041": false, // first line need not be a heading (YAML frontmatter)
  "MD024": { "siblings_only": true }, // repeated headings ok across sections
  "MD029": false, // ordered-list numbering style
  "MD046": false, // code block style (indented vs fenced both appear)
  "MD040": false, // fenced code language not required
  "MD036": false  // emphasis-as-heading (used intentionally in places)
}
